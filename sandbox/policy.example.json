{
  "version": 1,
  "zones": {
    "internal": {
      "cpus": 8,
      "memory_mib": 16384,
      "disk_gib": 200,
      "files": {
        "root": "/srv/sandbox-example/internal",
        "writable": true
      },
      "model": {
        "url": "https://llm.example.internal",
        "name": "example-internal-model",
        "token_file": "/etc/sandbox-example/internal-token"
      }
    },
    "confidential": {
      "cpus": 4,
      "memory_mib": 8192,
      "disk_gib": 100,
      "files": {
        "root": "/srv/sandbox-example/confidential",
        "writable": false
      },
      "model": {
        "url": "http://127.0.0.1:8080",
        "name": "example-local-model",
        "token_file": null
      }
    }
  }
}
