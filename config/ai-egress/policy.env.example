# Copy to a root-owned host configuration only after reviewing it.
AI_EGRESS_BRIDGE=incusbr0
AI_EGRESS_SUBNET=10.234.0.0/24
AI_EGRESS_DNS_IP=10.234.0.1
AI_EGRESS_MODE=baseline
# Strict mode requires a real HTTP CONNECT/SOCKS gateway. It rejects all
# container egress except DNS and this exact proxy endpoint.
AI_EGRESS_PROXY_IP=10.234.0.1
AI_EGRESS_PROXY_PORT=3128
